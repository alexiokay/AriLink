# AriLink Docker — Environment Variables
#
# Copy this file to the project root as .env:
#   cp docker/.env.example .env
#
# Then run:
#   docker compose up

# ─── ARI Credentials ───
# Username and password for the Asterisk REST Interface
# These are used by both the Asterisk container and the AriLink app
ASTERISK_LOGIN=arilink
ASTERISK_PASSWORD=arilink123

# ─── Stasis Application ───
STASIS_APP_NAME=stasis-app

# ─── Transcription ───
# Language for speech recognition
SPEECH_LANG=en-US

# ─── Assistant ───
# Which assistant handles incoming calls
# Available: ivr-transfer, direct-dial, auto-dialer
DEFAULT_ASSISTANT=ivr-transfer

# ─── TTS (Kokoro) ───
# Default voice for text-to-speech (af_heart, af_bella, am_adam, etc.)
TTS_VOICE=af_heart
# Speech speed (1.0 = normal)
TTS_SPEED=1.0
# Language code: a=American English, b=British, e=Spanish, f=French
TTS_LANG=a

# ─── Rust RTP (optional) ───
# Set to true and run with: docker compose --profile rust-rtp up
USE_RUST_RTP=false

# ─── WebSocket Secure Port (optional) ───
WSS_PORT=3044
