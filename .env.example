# ARI Stasi Server Configuration

# ============================================
# FreePBX / Asterisk Configuration
# ============================================
# PBX server IP address
PBX_IP=192.168.1.20

# ARI credentials (created in FreePBX: Settings → Asterisk REST Interface)
ASTERISK_LOGIN=your_ari_username
ASTERISK_PASSWORD=your_ari_password_here

# ============================================
# Transcription Services
# ============================================
# Comma-separated list of transcription services (tries in order)
# First service = primary, rest = automatic fallbacks
TRANSCRIPTION_SERVICES=ws://localhost:5000

# Service options:
# - ws://localhost:5000 = Parakeet TDT 0.6B-v3 (25 languages, fastest, RECOMMENDED)
# - ws://localhost:5001 = Whisper service (slower but accurate)
# - ws://localhost:5002 = Your custom transcription model
# - google = Google Cloud Speech (requires credentials below)

# Examples:
# TRANSCRIPTION_SERVICES=ws://localhost:5000                    # Parakeet only
# TRANSCRIPTION_SERVICES=ws://localhost:5000,ws://localhost:5001 # Parakeet + Whisper fallback
# TRANSCRIPTION_SERVICES=ws://localhost:5000,google              # Parakeet + Google fallback
# TRANSCRIPTION_SERVICES=google                                  # Google only (costs apply)

# Google Cloud credentials (only needed if "google" is in TRANSCRIPTION_SERVICES)
GOOGLE_APPLICATION_CREDENTIALS=path/to/google-credentials.json

# ============================================
# Transcription Settings
# ============================================
SPEECH_LANG=en-US
SPEECH_MODEL=phone_call
SPEAKER_DIARIZATION=false

# ============================================
# Server Configuration
# ============================================
LISTENER_SERVER=0.0.0.0:8000
WSS_PORT=3044
EXTERNAL_HOST=your-public-ip-or-domain

# ============================================
# SIP / Telephony (Optional - for making outbound calls)
# ============================================
SIP_PROVIDER=your_sip_provider_address
FROM_NUMBER=+1234567890
FROM_NUMBER2=+1234567891

# Test numbers (optional - for development/testing)
EXAMPLE_CALL_TO_NUMBER1=+1234567890
EXAMPLE_CALL_TO_NUMBER2=+1234567891
TEST_PHONE=+1234567890
TEST_PHONE2=+1234567891

# ============================================
# Optional: SSL/TLS
# ============================================
# SSL_CERT=path/to/cert.pem
# SSL_KEY=path/to/key.pem

# ============================================
# Optional: Audio Output (for debugging)
# ============================================
# AUDIO_OUTPUT=./recordings/
