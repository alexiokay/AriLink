# AriLink Configuration
#
# This file contains INFRASTRUCTURE settings only.
# Assistant-specific settings (prompts, behavior, transfer destination)
# go in each assistant's config.json file instead.

# ============================================
# FreePBX / Asterisk Configuration
# ============================================
PBX_IP=192.168.1.20
ASTERISK_LOGIN=your_ari_username
ASTERISK_PASSWORD=your_ari_password_here

# ============================================
# Transcription Services
# ============================================
# Comma-separated list (tries in order, first = primary, rest = fallbacks)
TRANSCRIPTION_SERVICES=ws://localhost:5000

# Service options:
# - ws://localhost:5000 = Parakeet TDT 0.6B-v3 (25 languages, fastest, RECOMMENDED)
# - ws://localhost:5001 = Whisper service (slower but accurate)
# - google = Google Cloud Speech (requires GOOGLE_CREDENTIALS_JSON)
#
# Examples:
# TRANSCRIPTION_SERVICES=ws://localhost:5000                     # Parakeet only
# TRANSCRIPTION_SERVICES=ws://localhost:5000,google              # Parakeet + Google fallback

# Auto-start Parakeet transcription service when Engine starts
# Requires: .venv set up in transcription-services/parakeet-service/
# AUTO_START_TRANSCRIPTION=true

# Device for Parakeet model inference (cuda or cpu)
# TRANSCRIPTION_DEVICE=cuda

# Google Cloud credentials (base64-encoded service account JSON)
# Paste JSON in the dashboard UI — it will be base64-encoded and stored here.
# The server auto-materializes this to a file and sets GOOGLE_APPLICATION_CREDENTIALS.
# GOOGLE_CREDENTIALS_JSON=

# ============================================
# Transcription Settings
# ============================================
SPEECH_LANG=en-US
SPEECH_MODEL=phone_call
SPEAKER_DIARIZATION=false

# ============================================
# Server Configuration
# ============================================
LISTENER_SERVER=0.0.0.0:8000
WSS_PORT=3044
EXTERNAL_HOST=your-public-ip-or-domain

# ============================================
# SIP / Telephony
# ============================================
# SIP_PROVIDER=your_sip_provider_address
FROM_NUMBER=+1234567890

# ============================================
# Stasis Application
# ============================================
STASIS_APP_NAME=stasis-app

# Which assistant to use for incoming calls (or use --assistant CLI flag)
# Available: ivr-transfer, direct-dial, auto-dialer
DEFAULT_ASSISTANT=ivr-transfer

# ============================================
# Fallback Transfer Settings
# ============================================
# These are FALLBACKS - prefer setting transfer in each assistant's config.json
# Only used if the assistant's config.json doesn't have transfer.destination/trunk
# TRANSFER_DESTINATION=100
# TRANSFER_TRUNK=from-internal

# ============================================
# Auto-Dialer (only if using auto-dialer assistant)
# ============================================
# Phone list path (or use --phone-list CLI flag)
# AUTODIALER_PHONE_LIST=./phone-list.json

# ============================================
# Text-to-Speech (TTS)
# ============================================
# Provider: "kokoro" (local, default) or "elevenlabs" (cloud)
# TTS_PROVIDER=kokoro

# --- Kokoro (local) ---
# TTS_SERVICE=ws://localhost:5001
# TTS_VOICE=af_heart
# TTS_SPEED=1.0
# TTS_LANG=a    # a=American English, b=British, e=Spanish, f=French, i=Italian, j=Japanese

# --- ElevenLabs (cloud) ---
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM    # Rachel (default). Find IDs at elevenlabs.io/voice-library
# ELEVENLABS_MODEL=eleven_flash_v2_5             # eleven_flash_v2_5 (fast) or eleven_multilingual_v2 (quality)
# TTS_LANG=en                                    # ISO 639-1 for ElevenLabs: en, pl, de, fr, es, it, etc.

# ============================================
# LLM Chat Brain (conversational AI assistant)
# ============================================
# Provider preset: ollama | gemini | openai | openrouter | custom
# Each preset auto-configures the correct API endpoint and default model.
# LLM_PROVIDER=ollama

# Override the default model for your provider
# LLM_MODEL=llama3.2

# API key (required for cloud providers, not needed for local Ollama)
# LLM_API_KEY=

# Custom endpoint (only needed with LLM_PROVIDER=custom or to override preset URL)
# LLM_ENDPOINT=http://localhost:11434

# ============================================
# Rust RTP Server (optional, replaces Node.js RTP pipeline)
# ============================================
# Set USE_RUST_RTP=true to delegate audio handling to the Rust binary
# USE_RUST_RTP=true
# RUST_SERVER_URL=http://localhost:9900
# RUST_TRANSCRIPTION_SERVICES=ws://parakeet:5000   # Override for Rust in Docker (uses Docker network names)
# RTP_LISTEN_PORT=8000

# ============================================
# Optional: SSL/TLS
# ============================================
# SSL_CERT=path/to/cert.pem
# SSL_KEY=path/to/key.pem

# ============================================
# AI Code Completion (dashboard assistant editor)
# ============================================
# Get a key at https://console.mistral.ai/ (Codestral model)
# MISTRAL_API_KEY=your_mistral_api_key

# ============================================
# WebRTC Softphone (built-in browser phone)
# ============================================
# SIP_WS_URL=wss://192.168.1.20:8089/ws
# SIP_DOMAIN=192.168.1.20
# SIP_ACCOUNTS=[{"extension":"1001","password":"secret","name":"Desk Phone"}]
# STUN_SERVER=stun:stun.l.google.com:19302
# SIP_CODECS=PCMU,PCMA

# ============================================
# SSH / Remote Asset Management
# ============================================
# Connect to FreePBX for terminal access and audio file management
# Leave SSH_HOST empty if core runs on the same machine as FreePBX
# SSH_HOST=192.168.1.20
# SSH_PORT=22
# SSH_USER=root
# SSH_PASSWORD=your_ssh_password
# SSH_KEY_PATH=~/.ssh/id_rsa

# Asterisk file paths (for the asset manager)
# AST_SOUNDS_PATH=/var/lib/asterisk/sounds/custom
# AST_MOH_PATH=/var/lib/asterisk/moh
# AST_RECORDINGS_PATH=/var/spool/asterisk/monitor

# ============================================
# Outbound Call Settings
# ============================================
# Sound file to play when outbound call connects (without "sound:" prefix)
# OUTGOING_WELCOME_SOUND=custom/welcome_2

# External API to log call usage (POST with phone, duration, assistantType)
# CALL_USAGE_API_URL=http://127.0.0.1:8001/api/registerCallUsage

# ============================================
# Standalone Engine Mode
# ============================================
# Port for the engine when running without the dashboard (npm run start:core)
# ENGINE_PORT=3012

# ============================================
# Dialing
# ============================================
# Secondary outbound number (optional)
# FROM_NUMBER2=+1234567891
# Test phone number for quick-dial testing
# TEST_PHONE=+1234567890

# ============================================
# Pro License (optional)
# ============================================
# PRO_LICENSE_KEY=your_license_key

# ============================================
# Optional: Audio Output (for debugging)
# ============================================
# AUDIO_OUTPUT=./recordings/
