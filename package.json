{
  "name": "ari-stasi-server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "use": "nvm use",
    "build": "node node_modules/typescript/bin/tsc",
    "watch": "node node_modules/typescript/bin/tsc -w",
    "clean": "node -e \"require('fs').readdirSync('core').filter(f=>f.endsWith('.js')).forEach(f=>require('fs').unlinkSync('core/'+f));require('fs').readdirSync('tools').filter(f=>f.endsWith('.js')&&f!=='google-speech-provider.js').forEach(f=>require('fs').unlinkSync('tools/'+f))\"",
    "start": "npx ts-node -T core/manager.ts",
    "start:clean": "npm run clean && npm start",
    "dev": "npm run watch"
  },
  "author": "Alexi Pawelec",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@aws-sdk/client-transcribe-streaming": "^3.354.0",
    "@google-cloud/speech": "^7.0.1",
    "ari-client": "^2.2.0",
    "aws-sdk": "^2.1692.0",
    "aws-transcribe": "^1.1.1",
    "chalk": "^5.4.1",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "moment": "^2.29.4",
    "request": "^2.88.2",
    "requests": "^0.3.0",
    "socket.io": "^4.6.2",
    "tsc": "^2.0.4",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
