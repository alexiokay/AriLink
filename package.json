  "main": "index.js",
  "scripts": {
    "dev": "node tools/dev-launcher.cjs",
    "build": "node tools/build-launcher.cjs",
    "start": "node tools/start-launcher.cjs",
    "postinstall": "npm run dashboard:install",
    "start:ivr": "DEFAULT_ASSISTANT=ivr-transfer npm run dev",
